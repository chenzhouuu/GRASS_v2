# GRASS Environment Configuration

# Neo4j connection (required)
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=your_password_here
NEO4J_DATABASE=neo4j

# Working directory for data output (required)
DATA_STORAGE_PATH=./data/
CONDA_ENV=grass

# LLM API keys — at least one provider is required
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...

# Optional providers
# GOOGLE_API_KEY=...
# GROQ_API_KEY=...

# LangSmith tracing (uncomment and set API key to enable)
# Get your key at https://smith.langchain.com/settings
# LANGCHAIN_API_KEY=lsv2_pt_...
# LANGCHAIN_TRACING_V2=true
# LANGCHAIN_PROJECT=grass
# LANGCHAIN_ENDPOINT=https://api.smith.langchain.com